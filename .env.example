# Sao thành .env (đã ignore). Chỉ cần khi chạy chế độ bảo mật (compose --profile secure).
MQTT_PASSWORD_HUB=
MQTT_PASSWORD_AI=
MQTT_PASSWORD_SENSOR=
MQTT_PASSWORD_DEVICE=
