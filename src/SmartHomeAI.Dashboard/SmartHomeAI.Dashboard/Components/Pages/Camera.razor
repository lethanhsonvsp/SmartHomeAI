@page "/camera"
@rendermode InteractiveServer
@implements IDisposable
@inject HubClient Hub
@inject IConfiguration Cfg

<PageTitle>Camera</PageTitle>
<h1>Camera</h1>

<div class="cam-wrap">
    <div class="cam-view">
        @* Trình duyệt tải luồng trực tiếp; JS thuần để Blazor re-render không đụng trạng thái hiện/ẩn. *@
        <img id="cam-img" alt="Luồng camera" src="@Url" style="width:100%;display:block"
             onload="document.getElementById('cam-err').style.display='none'"
             onerror="this.style.display='none';document.getElementById('cam-err').style.display='block'" />
        <div id="cam-err" class="card" style="display:none">
            <p class="err">Không có luồng camera. Chạy AI: python -m smarthome_ai --source 0 --detector pose ...</p>
            <button class="btn" onclick="var i=document.getElementById('cam-img');document.getElementById('cam-err').style.display='none';i.style.display='block';i.src='@Url'+'?t='+Date.now()">Thử lại</button>
        </div>
    </div>
    <div class="card cam-side">
        <h3>Trạng thái</h3>
        @if (_s is null)
        {
            <p class="err">Không kết nối được Hub</p>
        }
        else
        {
            var ai = _s.Online.FirstOrDefault(k => k.Key.Equals("ai", StringComparison.OrdinalIgnoreCase));
            <p>Hiện diện: <strong>@_s.Occupancy</strong></p>
            <p>Nguồn AI: <span class="dot @(ai.Value ? "up" : "down")"></span>@(ai.Value ? "online" : "offline")</p>
        }
    </div>
</div>

<style>
    .cam-wrap { display: flex; flex-wrap: wrap; gap: 1rem; align-items: flex-start; }
    .cam-view { flex: 2 1 320px; min-width: 0; }
    .cam-side { flex: 1 1 200px; }
</style>

@code {
    HubSnapshot? _s;
    Timer? _t;
    string Url => Cfg["Camera:StreamUrl"] ?? "http://localhost:8090/stream.mjpg";

    protected override async Task OnInitializedAsync()
    {
        _s = await Hub.State();
        _t = new Timer(async _ => { _s = await Hub.State(); await InvokeAsync(StateHasChanged); }, null, 2000, 2000);
    }

    public void Dispose() => _t?.Dispose();
}
