@page "/alerts"
@rendermode InteractiveServer
@implements IDisposable
@inject HubClient Hub

<PageTitle>Cảnh báo</PageTitle>
<h1>Cảnh báo</h1>

@if (_a is null)
{
    <p class="err">Không kết nối được Hub</p>
}
else if (_a.Count == 0)
{
    <p>Chưa có cảnh báo</p>
}
else
{
    @foreach (var x in _a)
    {
        <div class="card">
            <small>Báo lúc @x.RaisedAt.ToLocalTime().ToString("dd/MM HH:mm:ss")</small>
            <p>@(x.CancelledAt is null ? "Đang hiệu lực" : $"Đã hủy lúc {x.CancelledAt.Value.ToLocalTime():HH:mm:ss}: {Why(x.Reason)}")</p>
            <p>Phản hồi: @(x.Feedback switch { "Correct" => "Đúng", "Wrong" => "Sai", _ => "Chưa có" })</p>
            <button class="btn" disabled="@(x.Feedback != "None")" @onclick="() => Send(x.Id, true)">Đúng</button>
            <button class="btn" disabled="@(x.Feedback != "None")" @onclick="() => Send(x.Id, false)">Sai</button>
        </div>
    }
}

@code {
    List<AlertItem>? _a;
    Timer? _t;

    protected override async Task OnInitializedAsync()
    {
        _a = await Hub.Alerts();
        _t = new Timer(async _ => { _a = await Hub.Alerts(); await InvokeAsync(StateHasChanged); }, null, 2000, 2000);
    }

    async Task Send(string id, bool correct) { await Hub.Feedback(id, correct); _a = await Hub.Alerts(); }

    static string Why(string? r) => r switch
    {
        "PersonReturned" => "người đã về",
        "DevicesOff" => "thiết bị đã tắt",
        "DataLost" => "mất dữ liệu camera",
        _ => "không rõ lý do",
    };

    public void Dispose() => _t?.Dispose();
}
