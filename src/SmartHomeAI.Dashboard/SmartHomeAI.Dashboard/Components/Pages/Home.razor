@page "/"
@rendermode InteractiveServer
@implements IDisposable
@inject HubClient Hub
@inject IConfiguration Cfg
@inject NavigationManager Nav
@inject SmartHomeAI.Dashboard.Services.HubLauncher Launcher
@inject SmartHomeAI.Dashboard.Services.AiRunner Ai
@inject SmartHomeAI.Dashboard.Services.SimRunner Sim
@inject SmartHomeAI.Dashboard.Services.AiApi AiApi
@inject SmartHomeAI.Dashboard.Services.ScenarioRunner Scn

<PageTitle>SmartHomeAI</PageTitle>

<div class="app" data-tab="@_tab">
    <header class="status p-ov">
        <div class="brand"><span class="brand-mark" aria-hidden="true">⌂</span><span><strong>SmartHome<span>AI</span></strong><small>Không gian thông minh của bạn</small></span></div>
        <span class="chip"><span class="dot @(HubUp ? "up" : "down")"></span>Hub <small>@HubText</small></span>
        @if (_s is null) { <span class="chip err">Không kết nối được Hub</span> }
        @if (_msg is not null) { <span class="chip err">@_msg</span> }
        <a class="btn" href="/setup">Cài đặt</a>
        <button class="btn simbtn" @onclick="() => _simOpen = !_simOpen">Mô phỏng</button>
    </header>

    <section class="pane cam p-cam">
        <div class="head">
            <div class="section-title"><span class="eyebrow">GIÁM SÁT TRỰC QUAN</span><h3>Camera</h3></div>
            <label class="switch" title="Bật/tắt bộ AI">
                <input type="checkbox" aria-label="Bật hoặc tắt AI camera" checked="@(Ai.State is SmartHomeAI.Dashboard.Services.AiState.Running or SmartHomeAI.Dashboard.Services.AiState.Starting)"
                       disabled="@Ai.Busy" @onchange="ToggleAi" />
                <span class="slider"></span>
            </label>
            <span>AI: @AiText</span>
            <small class="muted">@Ai.Model</small>
        </div>
        @if (Ai.State == SmartHomeAI.Dashboard.Services.AiState.Error)
        {
            <pre class="err logtail">@string.Join("\n", Ai.LogTail)</pre>
        }
        <div class="ovl">
            @{ var up = Ai.State == SmartHomeAI.Dashboard.Services.AiState.Running && _cfg is not null; }
            @foreach (var (k, n) in Ovl)
            {
                var kk = k;
                <button class="btn @(up && _cfg![kk] ? "on" : "")" disabled="@(!up)" @onclick="() => SetOvl(kk)">@n</button>
            }
            <button class="btn" disabled="@(!up)" onclick="zoneEditor.open()">Vẽ lại vùng</button>
            @if (!up) { <small>AI đang dừng: bật AI để đổi lớp phủ và vẽ vùng.</small> }
        </div>
        <div class="cam-box">
            <div id="zed" class="zed" hidden></div>
            <div class="cam-ph">
                <p>@(Ai.State == SmartHomeAI.Dashboard.Services.AiState.Running ? "Đang chờ luồng camera..." : "Camera tắt. Bật công tắc AI để xem.")</p>
                @if (Ai.State == SmartHomeAI.Dashboard.Services.AiState.Running)
                {
                    <button class="btn" onclick="camRetry(document.getElementById('cam-img'), true)">Thử lại</button>
                }
            </div>
            @if (Ai.State == SmartHomeAI.Dashboard.Services.AiState.Running)
            {
                @* @key đổi mỗi lần AI vào Running: tạo lại thẻ img, nạp luồng mới. *@
                <img @key="_camGen" id="cam-img" alt="Luồng camera" src="@(Url)?t=@_camGen" data-base="@Url" style="opacity:0"
                     onload="this.style.opacity=1;this.dataset.n=0" onerror="camRetry(this)" />
            }
        </div>
    </section>

    <section class="pane people p-ov">
        <div class="head">
            <div class="section-title"><span class="eyebrow">CAMERA NHẬN DIỆN</span><h3>Hiện diện</h3></div>
            @if (_s is not null)
            {
                <span class="chip occ @_s.Occupancy" title="@Note(_s.Occupancy)">@OccVi(_s.Occupancy)</span>
                <span class="chip">@_s.PersonCount người</span>
            }
        </div>
        @if (_s?.Persons is { Count: > 0 })
        {
            <div class="scroll">
                <table>
                    <thead><tr><th>ID</th><th>Vùng</th><th>Tư thế</th></tr></thead>
                    <tbody>
                    @foreach (var p in _s.Persons)
                    {
                        <tr><td>@p.TrackId</td><td>@Zone(p.Zone)</td><td>@Posture(p.Posture)</td></tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </section>

    <section class="pane devs p-ov">
        <div class="head">
            <div class="section-title"><span class="eyebrow">PHẦN CỨNG</span><h3>Thiết bị</h3></div>
            <span class="seg" role="group" aria-label="Chế độ điều khiển">
                <button class="btn @(_s?.Mode == "auto" ? "on" : "")" disabled="@(_s is null)" @onclick="() => Mode(true)">Auto</button><button class="btn @(_s?.Mode == "manual" ? "on" : "")" disabled="@(_s is null)" @onclick="() => Mode(false)">Manual</button>
            </span>
        </div>
        @if (_tp is { State: "connecting" }) { <div class="warn">Đang đăng nhập ổ cắm P100...</div> }
        else if (_tp is not null and not { State: "connected" })
        {
            <div class="warn">Ổ cắm P100 chưa đăng nhập. <a href="/setup">Mở Cài đặt</a></div>
        }
        else if (_s is not null && !PlugUp)
        {
            <div class="err warn">Ổ cắm chưa kết nối: lệnh sẽ không có tác dụng. Kiểm tra P100 trong <a href="/setup">Cài đặt</a> hoặc bật mô phỏng ổ cắm.
                @if (!Sim.Plug.On) { <button class="btn" @onclick="() => Sim.Plug.Set(true)">Bật mô phỏng ổ cắm</button> }
            </div>
        }
        @foreach (var (id, name) in Devs)
        {
            var on = _s is not null && _s.Devices.TryGetValue(id, out var dv) && dv.On;
            <div class="dev">
                <span class="dot @(PlugUp ? "up" : "down")" title="@(PlugUp ? "Đang kết nối" : "Mất kết nối")"></span>
                <span class="dev-name"><b>@name</b><small>Tapo P100</small></span>
                <b>@(on ? "Bật" : "Tắt")</b>
                <button class="btn @(on ? "on" : "")" disabled="@(_s is null || _s.Mode != "manual")" @onclick="() => Dev(id, !on)">@(on ? "Tắt" : "Bật")</button>
            </div>
            @if (_s is { Mode: not "manual" }) { <small class="muted">Đang ở chế độ Auto: chuyển sang Manual để bật/tắt bằng tay.</small> }
            @if (_pend is { } pd && pd.Id == id && DateTime.UtcNow - pd.At > TimeSpan.FromSeconds(3) && on != pd.On) { <small class="err">Chưa thấy thiết bị phản hồi</small> }
            @if (Reason(id) is { } rs) { <small class="why">@rs</small> }
        }
        @{
            var env = _s?.Env.Values.FirstOrDefault(); var door = _s?.Door.Values.FirstOrDefault();
            var esp = _s?.Online.Any(x => x.Key.StartsWith("sensor/") && x.Value) == true;
        }
        <div class="dev">
            <span class="dot @(Up("ai") ? "up" : "down")" title="@(Up("ai") ? "Đang gửi dữ liệu" : "Không có dữ liệu")"></span>
            <span class="dev-name"><b>Camera</b><small>Tapo C222 4MP</small></span>
            <b>@(Up("ai") ? "Đang nhận diện" : "Không có dữ liệu")</b>
        </div>
        @foreach (var (n, m, v) in new[] {
            ("Nhiệt độ, độ ẩm", "SHT30", env is null ? "–" : $"{env.TempC:0.#} °C · {env.Humidity:0.#} %"),
            ("Ánh sáng", "BH1750", env is null ? "–" : $"{env.Lux:0} lux"),
            ("Cửa", "MC-38", door is null ? "–" : door.Open ? "Mở" : "Đóng") })
        {
            <div class="dev">
                <span class="dot @(esp ? "up" : "down")" title="@(esp ? "ESP32 đang kết nối" : "ESP32 mất kết nối")"></span>
                <span class="dev-name"><b>@n</b><small>@m · ESP32</small></span>
                <b>@v</b>
            </div>
        }
    </section>

    <section class="pane log-pane p-lg">
        <div class="head">
            <div class="section-title"><span class="eyebrow">DÒNG THỜI GIAN</span><h3>Nhật ký hoạt động</h3></div>
            <span class="seg">
                @foreach (var (k, n) in Filters)
                {
                    var kk = k;
                    <button class="btn @(_flt == kk ? "on" : "")" @onclick="() => _flt = kk">@n</button>
                }
            </span>
        </div>
        <div class="scroll log">
            @if (_unsupported) { <p class="muted">Hub chưa hỗ trợ nhật ký</p> }
            else if (_ev is null) { <p class="err">Không kết nối được Hub</p> }
            else if (Shown.Count == 0) { <p class="muted">Chưa có sự kiện</p> }
            @foreach (var (key, x) in Shown)
            {
                <div class="ev k-@x.Kind" @key="key">
                    <small>@x.Ts.ToLocalTime().ToString("HH:mm:ss")</small>
                    <span class="ic" aria-hidden="true">@Icon(x.Kind)</span>
                    <span>@x.Message</span>
                </div>
            }
        </div>
    </section>

    <section class="pane alerts p-al">
        <span class="eyebrow">AN TOÀN</span><h3>Cảnh báo</h3>
        <div class="scroll">
            @if (_a is null) { <p class="err">Không kết nối được Hub</p> }
            else if (_a.Count == 0) { <p class="muted">Chưa có cảnh báo</p> }
            @foreach (var x in _a ?? [])
            {
                <div class="alert-row">
                    <small>@x.RaisedAt.ToLocalTime().ToString("dd/MM HH:mm:ss")</small>
                    @(x.CancelledAt is null ? "Đang hiệu lực" : $"Đã hủy lúc {x.CancelledAt.Value.ToLocalTime():HH:mm:ss}: {Why(x.Reason)}")
                    · Phản hồi: @(x.Feedback switch { "Correct" => "Đúng", "Wrong" => "Sai", _ => "chưa có" })
                    <span class="fb">
                        <button class="btn" disabled="@(x.Feedback != "None")" @onclick="() => Send(x.Id, true)">Đúng</button>
                        <button class="btn" disabled="@(x.Feedback != "None")" @onclick="() => Send(x.Id, false)">Sai</button>
                    </span>
                </div>
            }
        </div>
    </section>

    <aside class="pane simpane p-sim @(_simOpen ? "open" : "")">
        <div class="head"><h3>Mô phỏng</h3><button class="btn simclose" @onclick="() => _simOpen = false">Đóng</button></div>
        <div class="scroll">
            <div class="devrow">
                <span>Mô phỏng cảm biến (ESP32): <b>@(Sim.Esp.On ? "đang chạy" : "tắt")</b></span>
                <label class="switch"><input type="checkbox" checked="@Sim.Esp.On" @onchange="e => ToggleSim(Sim.Esp, e.Value is true)" /><span class="slider"></span></label>
            </div>
            @if (Sim.Esp.Error is { } ee) { <p class="err">@ee</p> }
            <div class="devrow">
                <span>Mô phỏng ổ cắm (đèn, quạt trần): <b>@(Sim.Plug.On ? "đang chạy" : "tắt")</b></span>
                <label class="switch"><input type="checkbox" checked="@Sim.Plug.On" @onchange="e => ToggleSim(Sim.Plug, e.Value is true)" /><span class="slider"></span></label>
            </div>
            @if (Sim.Plug.Error is { } pe) { <p class="err">@pe</p> }
            <div class="scn">
                <h3>Kịch bản</h3>
                @if (Scn.ListError is { } le) { <p class="err">@le</p><button class="btn" @onclick="() => Scn.Reload()">Tải lại danh sách</button> }
                else if (Scn.List.Count == 0) { <p class="muted">Chưa có kịch bản</p> }
                else
                {
                    <div class="scn-list" role="listbox">
                        @foreach (var sc in Scn.List)
                        {
                            var cc = sc.Code;
                            @if (sc.Group != Scn.List.TakeWhile(y => y != sc).LastOrDefault()?.Group) { <small class="muted">@sc.Group</small> }
                            <button class="btn @(_scn == cc ? "on" : "")" role="option" aria-selected="@(_scn == cc)" @onclick="() => _scn = cc"><b>@cc</b> @sc.Title</button>
                        }
                    </div>
                    @if (Scn.List.FirstOrDefault(x => x.Code == _scn) is { } cur)
                    {
                        <div class="scn-info">
                            @if (cur.Description is { Length: > 0 }) { <p>@cur.Description</p> }
                            @if (cur.Expect.Length > 0) { <small>Kỳ vọng:</small><ul>@foreach (var x in cur.Expect) { <li>@x</li> }</ul> }
                            <small>@(cur.DurationSec > 0 ? $"Thời lượng gốc {cur.DurationSec:0} giây" : "")@(cur.Requires.Contains("p100") ? ", cần: ổ cắm giả" : "")</small>
                        </div>
                    }
                    <div class="seg scn-speed">
                        @foreach (var sp in SmartHomeAI.Dashboard.Services.ScenarioRunner.Speeds)
                        {
                            var ss = sp;
                            <button class="btn @(_spd == ss ? "on" : "")" disabled="@Scn.Running" @onclick="() => _spd = ss">@(ss)x</button>
                        }
                    </div>
                    <small class="muted">@SmartHomeAI.Dashboard.Services.ScenarioRunner.SpeedNote</small>
                    <div class="scn-act">
                        <button class="btn on" disabled="@(Scn.Running || _scn is null || ScnBlock is not null)" @onclick="RunScn">Chạy</button>
                        <button class="btn" disabled="@(!Scn.Running)" @onclick="() => Scn.Stop()">Dừng</button>
                    </div>
                    @if (ScnBlock is { } sb) { <p class="err">@sb</p> }
                    @if (Scn.State != SmartHomeAI.Dashboard.Services.ScenarioState.Idle || Scn.Code is not null)
                    {
                        <p><b class="@(Scn.State == SmartHomeAI.Dashboard.Services.ScenarioState.Error ? "err" : "")">@Scn.Code: @(Scn.State switch { SmartHomeAI.Dashboard.Services.ScenarioState.Running => "Đang chạy", SmartHomeAI.Dashboard.Services.ScenarioState.Done => "Xong", SmartHomeAI.Dashboard.Services.ScenarioState.Error => "Lỗi", _ => "Đã dừng" })</b>
                            <small>(ước tính @Scn.EstSec.ToString("0") giây)</small></p>
                        @if (Scn.Note is { } sn) { <small>@sn</small> }
                        @if (!Scn.Running && !Sim.Esp.On) { <small class="muted">ESP32 giả đã tắt</small> }
                        <progress class="scn-bar" max="1" value="@Scn.Progress.ToString("0.00", Inv)"></progress>
                        @if (Scn.Error is { } se) { <p class="err">@se</p> }
                        @if (Scn.LogTail.Length > 0) { <pre class="logtail">@string.Join("\n", Scn.LogTail)</pre> }
                        <small>Phản ứng của Hub:</small>
                        @foreach (var x in (_ev ?? []).Take(5)) { <div class="ev k-@x.Kind"><small>@x.Ts.ToLocalTime().ToString("HH:mm:ss")</small><span class="ic" aria-hidden="true">@Icon(x.Kind)</span><span>@x.Message</span></div> }
                    }
                }
            </div>
            @if (Sim.Esp.On)
            {
                @if (_esp is null) { <p class="muted">Đang chờ cổng điều khiển ESP32 giả...</p> }
                else
                {
                    <div class="slide"><label for="s-t">Nhiệt độ: <b>@_esp.TempC.ToString("0.#") °C</b></label>
                        <input id="s-t" type="range" min="-20" max="60" step="0.5" value="@_esp.TempC.ToString("0.#", Inv)" @onchange='e => Put("tempC", ParseD(e))' /></div>
                    <div class="slide"><label for="s-h">Độ ẩm: <b>@_esp.Humidity.ToString("0.#") %</b></label>
                        <input id="s-h" type="range" min="0" max="100" step="1" value="@_esp.Humidity.ToString("0.#", Inv)" @onchange='e => Put("humidity", ParseD(e))' /></div>
                    <div class="slide"><label for="s-l">Ánh sáng: <b>@_esp.Lux.ToString("0") lux</b> (thang log, 0–2000)</label>
                        <input id="s-l" type="range" min="0" max="1000" step="5" value="@LuxToPos(_esp.Lux)" @onchange='e => Put("lux", PosToLux(ParseD(e)))' /></div>
                    <div class="devrow"><span>Cửa: <b>@(_esp.DoorOpen ? "mở" : "đóng")</b></span>
                        <label class="switch"><input type="checkbox" checked="@_esp.DoorOpen" @onchange='e => Put("doorOpen", e.Value is true)' /><span class="slider"></span></label></div>
                    <p>Còi buzzer: <b class="@(_esp.Buzzer ? "err" : "")">@(_esp.Buzzer ? "đang kêu" : "im")</b></p>
                }
            }
        </div>
    </aside>

    <nav class="tabs" aria-label="Chuyển ô">
        @foreach (var (k, n) in Tabs)
        {
            <button class="@(_tab == k ? "on" : "")" @onclick="() => _tab = k">@n</button>
        }
    </nav>
</div>

@code {
    static readonly (string, string)[] Devs = [("light", "Ổ cắm")];
    static readonly (string, string)[] Ovl = [("skeleton", "Khung xương"), ("boxes", "Hộp"), ("labels", "Nhãn"), ("zones", "Vùng"), ("sofa_lying", "Cam trên cao: ở sofa coi là nằm")];
    Dictionary<string, bool>? _cfg;
    static readonly (string, string)[] Filters = [("all", "Tất cả"), ("act", "Chỉ hành động"), ("wait", "Chỉ lý do chờ")];

    // Khóa ổn định (giờ + nội dung + thứ tự trùng) để DOM giữ nguyên khi có dòng mới, trình duyệt neo vị trí cuộn.
    List<(string, EventItem)> Shown
    {
        get
        {
            var seen = new Dictionary<string, int>();
            return (_ev ?? []).Where(e => _flt switch { "act" => e.Kind is "auto" or "manual" or "device", "wait" => e.Kind == "wait", _ => true })
                .Select(e => { var b = $"{e.Ts.Ticks}|{e.Message}"; seen[b] = seen.GetValueOrDefault(b) + 1; return (b + "|" + seen[b], e); }).ToList();
        }
    }

    static string Icon(string k) => k switch { "auto" => "⚡", "wait" => "⏳", "manual" => "👆", "alert" => "⚠", "occupancy" => "👤", _ => "•" };

    // Sự kiện auto/wait mới nhất của thiết bị (danh sách mới nhất trước).
    string? Reason(string id)
    {
        var e = _ev?.FirstOrDefault(x => x.Device == id && x.Kind is "auto" or "wait");
        if (e is null) return null;
        return e.Kind == "wait" ? "Đang chờ: " + e.Message : $"Vừa tự {(e.On == false ? "tắt" : "bật")} lúc {e.Ts.ToLocalTime():HH:mm}";
    }

    static readonly (string, string)[] Tabs = [("ov", "Tổng quan"), ("cam", "Camera"), ("lg", "Nhật ký"), ("al", "Cảnh báo"), ("sim", "Mô phỏng")];
    static readonly System.Globalization.CultureInfo Inv = System.Globalization.CultureInfo.InvariantCulture;
    HubSnapshot? _s;
    bool PlugUp => _tp is { State: "connected" } || Up("device");
    bool Up(string k) => _s is not null && _s.Online.TryGetValue(k, out var o) && o;
    List<AlertItem>? _a;
    List<EventItem>? _ev;
    TapoStatus? _tp;
    bool _unsupported;
    string _flt = "all";
    EspState? _esp;
    string? _msg;
    string _tab = "ov";
    bool _simOpen;
    string? _scn; int _spd = SmartHomeAI.Dashboard.Services.ScenarioRunner.DefaultSpeed, _per = 2000;
    string? ScnBlock => Scn.AiBlocks ? "Tắt AI camera trước (kịch bản và camera cùng gửi dữ liệu người)" : _s is null ? "Hub chưa online" : null;
    async Task RunScn() { if (_scn is not null && await Scn.Run(_scn, _spd) is { } m) _msg = m; }
    long _camGen = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds();
    SmartHomeAI.Dashboard.Services.AiState _lastAi;
    Timer? _t;

    // Luồng MJPEG do trình duyệt tải: "localhost" trong cấu hình đổi thành máy đang mở trang (điện thoại).
    string Url => (Cfg["Camera:StreamUrl"] ?? "http://localhost:8090/stream.mjpg").Replace("localhost", new Uri(Nav.Uri).Host);
    bool HubUp => Launcher.Status is not SmartHomeAI.Dashboard.Services.HubStatus.Failed && _s is not null;
    string HubText => _s is null && Launcher.Status != SmartHomeAI.Dashboard.Services.HubStatus.Failed
        ? "đang khởi động..."
        : Launcher.Status switch
        {
            SmartHomeAI.Dashboard.Services.HubStatus.Started => "tự khởi động",
            SmartHomeAI.Dashboard.Services.HubStatus.Failed => "lỗi: " + Launcher.Detail,
            _ => _s is null ? "không phản hồi" : "chạy",
        };
    string AiText => Ai.State switch
    {
        SmartHomeAI.Dashboard.Services.AiState.Running => "đang chạy",
        SmartHomeAI.Dashboard.Services.AiState.Starting => "đang khởi động...",
        SmartHomeAI.Dashboard.Services.AiState.Error => "lỗi",
        _ => "dừng",
    };

    protected override async Task OnInitializedAsync()
    {
        _lastAi = Ai.State;
        await Refresh();
        if (Scn.List.Count == 0) _ = Scn.Reload();
        _t = new Timer(async _ =>
        {
            await Refresh(); await InvokeAsync(StateHasChanged);
            // Nhanh hơn (1 giây) khi có kịch bản chạy để thấy phản ứng của Hub.
            var want = Scn.Running ? 1000 : 2000;
            if (want != _per) { _per = want; _t?.Change(want, want); }
        }, null, 2000, 2000);
    }

    async Task Refresh()
    {
        // Mỗi lần AI vào Running đổi _camGen để tạo lại thẻ img; rời Running thì thẻ bị gỡ.
        if (Ai.State != _lastAi)
        {
            if (Ai.State == SmartHomeAI.Dashboard.Services.AiState.Running) _camGen = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds();
            _lastAi = Ai.State;
        }
        _cfg = Ai.State == SmartHomeAI.Dashboard.Services.AiState.Running ? await AiApi.GetConfig() : null;
        _s = await Hub.State(); _a = await Hub.Alerts();
        (_ev, _unsupported) = await Hub.Events();
        if (_pend is { } pd && _s is not null && _s.Devices.TryGetValue(pd.Id, out var cur) && cur.On == pd.On) _pend = null;
        _esp = Sim.Esp.On ? await Sim.EspState() : null;
        _tp = await Hub.Tapo();
    }

    async Task SetOvl(string k)
    {
        if (_cfg is null) return;
        if (await AiApi.SetConfig(k, !_cfg[k])) _cfg[k] = !_cfg[k]; else _msg = "Đổi lớp phủ thất bại";
    }
    async Task Mode(bool auto) => await Act(Hub.SetMode(auto));
    (string Id, bool On, DateTime At)? _pend;
    async Task Dev(string id, bool on) { _pend = (id, on, DateTime.UtcNow); await Act(Hub.SetDevice(id, on)); }
    async Task Act(Task<bool> call) { _msg = await call ? null : "Gửi lệnh thất bại"; await Refresh(); }
    async Task Send(string id, bool correct) { await Hub.Feedback(id, correct); _a = await Hub.Alerts(); }
    async Task ToggleAi(ChangeEventArgs e) { await Ai.SetEnabled(e.Value is true); }
    async Task ToggleSim(SmartHomeAI.Dashboard.Services.SimProc p, bool on) { if (on && p == Sim.Plug && _tp?.State is "connected" or "connecting") { _msg = "Đang dùng P100 thật, đăng xuất trước khi bật ổ cắm giả"; return; } await Task.Run(() => p.Set(on)); if (!on) _esp = null; }
    async Task Put(string key, object v)
    {
        _msg = await Sim.EspSet(new Dictionary<string, object> { [key] = v }) ? null : "ESP32 giả từ chối giá trị";
        _esp = await Sim.EspState();
    }

    static double ParseD(ChangeEventArgs e) => double.Parse(e.Value?.ToString() ?? "0", Inv);
    static double LuxToPos(double lux) => Math.Round(Math.Log(Math.Clamp(lux, 0, 2000) + 1) / Math.Log(2001) * 1000);
    static double PosToLux(double pos) => Math.Round(Math.Pow(2001, pos / 1000) - 1);

