{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Hub": {
    "BaseUrl": "http://localhost:5002",
    "Command": "dotnet",
    "Args": "run --project src/SmartHomeAI.Hub --no-launch-profile",
    "UsePostgres": false
  },
  "Camera": {
    "StreamUrl": "http://localhost:8090/stream.mjpg"
  },
  "Repo": {
    "Root": ""
  },
  "Startup": {
    "StartMosquitto": true
  },
  "Ai": {
    "Source": "0",
    "Detector": "pose",
    "Zones": "ai/config/zones.example.json",
    "Host": "localhost",
    "StreamPort": "8090"
  },
  "Dashboard": {
    "ApiKey": ""
  }
}