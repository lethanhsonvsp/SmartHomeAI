{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Hub": {
    "BaseUrl": "http://localhost:5002",
    "Command": "dotnet",
    "Args": "run --project src/SmartHomeAI.Hub --no-launch-profile",
    "UsePostgres": false
  },
  "Camera": {
    "StreamUrl": "http://localhost:8090/stream.mjpg"
  },
  "Repo": {
    "Root": ""
  },
  "Startup": {
    "StartMosquitto": true
  },
  "Ai": {
    "Source": "0",
    "Detector": "pose",
    "Zones": "",
    "Host": "localhost",
    "StreamPort": "8090"
  },
  "Sim": {
    "Python": "sim/.venv/bin/python",
    "EspArgs": "-m sim esp --control-port 8091",
    "PlugArgs": "-m sim p100",
    "EspControlPort": "8091"
  },
  "Dashboard": {
    "ApiKey": ""
  }
}